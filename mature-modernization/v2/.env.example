CHA_V2_SERVICE_NAME=jdair-cha-v2
CHA_V2_ENVIRONMENT=production
CHA_V2_ALLOWED_HOSTS=cha.jdair.top,127.0.0.1,localhost
CHA_V2_LEGACY_BASE_URL=http://127.0.0.1:8790
CHA_V2_LEGACY_TIMEOUT_SECONDS=20
CHA_V2_DASHBOARD_DEVICE_TTL_SECONDS=15
CHA_V2_DASHBOARD_VIDEO_TTL_SECONDS=180
CHA_V2_DASHBOARD_FLIGHT_TTL_SECONDS=60
CHA_V2_DASHBOARD_ROUTINE_TTL_SECONDS=300
CHA_V2_DASHBOARD_TREND_TTL_SECONDS=300
CHA_V2_DASHBOARD_STALE_SECONDS=3600
CHA_V2_DASHBOARD_INITIAL_WAIT_SECONDS=1.5
CHA_V2_DASHBOARD_STATE_DIR=/opt/jdair-cha/v2/data

# M3.1 CHA session lifecycle.
CHA_V2_REALTIME_SESSION_TTL_SECONDS=60
CHA_V2_REALTIME_CLEANUP_INTERVAL_SECONDS=10
CHA_V2_REALTIME_CLOSED_RETENTION_SECONDS=300
CHA_V2_REALTIME_COMMAND_TIMEOUT_SECONDS=5
# M3 FINAL verified six concurrent streams on one native AEE session.
# Keep this at or below a separately validated account/device limit.
CHA_V2_REALTIME_MAX_STREAMS_PER_SESSION=6
# Required abuse guards for production. Defaults are intentionally moderate.
CHA_V2_REALTIME_MAX_SESSIONS_PER_OWNER=3
CHA_V2_REALTIME_SESSION_CREATE_LIMIT=10
CHA_V2_REALTIME_SESSION_CREATE_WINDOW_SECONDS=60
# Bounds process-local CLOSED session history used for diagnostics.
CHA_V2_REALTIME_MAX_RETAINED_SESSIONS=128
# Optional additional trusted browser origins, comma-separated.
# Normal same-origin access is accepted automatically.
CHA_V2_REALTIME_ALLOWED_ORIGINS=
# Security-sensitive compatibility switch. Keep false in production.
CHA_V2_REALTIME_ALLOW_MISSING_WS_ORIGIN=false
# Required when realtime is enabled. Comma-separated existing CHA usernames.
# Empty means no authenticated user may enter the realtime Canary.
CHA_V2_REALTIME_CANARY_USERS=

# Required, security-sensitive AEE credentials remain server-side.
# Never commit or expose real values to browser code, logs or support bundles.
CHA_V2_AEE_API_BASE_URL=
CHA_V2_AEE_ORIGIN=
CHA_V2_AEE_GATEWAY_HOST=
CHA_V2_AEE_GATEWAY_PORT=7711
CHA_V2_AEE_GATEWAY_SSL=false
CHA_V2_AEE_GATEWAY_HTTP_PROXY=
CHA_V2_AEE_USERNAME=
CHA_V2_AEE_PASSWORD=
CHA_V2_AEE_LOGIN_TIMEOUT_SECONDS=15
CHA_V2_AEE_CONNECT_TIMEOUT_SECONDS=15

# The RC contains M3 code but production realtime remains off by default.
CHA_V2_FEATURE_DASHBOARD_V2=true
CHA_V2_FEATURE_REALTIME_READONLY=false
CHA_V2_FEATURE_REALTIME_AUDIO=false
CHA_V2_FEATURE_REALTIME_CONTROL=false
CHA_V2_FEATURE_ACCOUNT_POOL_V2=false
CHA_V2_FEATURE_RECORDS_V2=false
CHA_V2_FEATURE_INSPECTION_V2=false
# Optional non-production inspection store mode: "" (default) or "memory".
# The memory store is process-local, loses history on restart and is never
# enabled in production. Production must keep this empty until a durable
# PostgreSQL store is wired and rehearsed.
CHA_V2_INSPECTION_STORE_MODE=
