CHA_V2_SERVICE_NAME=jdair-cha-v2
CHA_V2_ENVIRONMENT=production
CHA_V2_ALLOWED_HOSTS=cha.jdair.top,127.0.0.1,localhost
CHA_V2_LEGACY_BASE_URL=http://127.0.0.1:8790
CHA_V2_LEGACY_TIMEOUT_SECONDS=20
CHA_V2_DASHBOARD_DEVICE_TTL_SECONDS=15
CHA_V2_DASHBOARD_VIDEO_TTL_SECONDS=180
CHA_V2_DASHBOARD_FLIGHT_TTL_SECONDS=60
CHA_V2_DASHBOARD_ROUTINE_TTL_SECONDS=300
CHA_V2_DASHBOARD_TREND_TTL_SECONDS=300
CHA_V2_DASHBOARD_STALE_SECONDS=3600
CHA_V2_DASHBOARD_INITIAL_WAIT_SECONDS=1.5
CHA_V2_DASHBOARD_STATE_DIR=/opt/jdair-cha/v2/data

# M3.1 CHA session lifecycle.
CHA_V2_REALTIME_SESSION_TTL_SECONDS=60
CHA_V2_REALTIME_CLEANUP_INTERVAL_SECONDS=10
CHA_V2_REALTIME_CLOSED_RETENTION_SECONDS=300
CHA_V2_REALTIME_COMMAND_TIMEOUT_SECONDS=5
# M3.2A verified four concurrent streams on one native AEE session.
# Keep this at or below a separately validated account/device limit.
CHA_V2_REALTIME_MAX_STREAMS_PER_SESSION=4

# M3.1 AEE credentials remain server-side. Never commit real values.
CHA_V2_AEE_API_BASE_URL=
CHA_V2_AEE_ORIGIN=
CHA_V2_AEE_GATEWAY_HOST=
CHA_V2_AEE_GATEWAY_PORT=7711
CHA_V2_AEE_GATEWAY_SSL=false
CHA_V2_AEE_GATEWAY_HTTP_PROXY=
CHA_V2_AEE_USERNAME=
CHA_V2_AEE_PASSWORD=
CHA_V2_AEE_LOGIN_TIMEOUT_SECONDS=15
CHA_V2_AEE_CONNECT_TIMEOUT_SECONDS=15

# The release contains M3.1 code but production realtime remains off.
CHA_V2_FEATURE_DASHBOARD_V2=true
CHA_V2_FEATURE_REALTIME_READONLY=false
CHA_V2_FEATURE_REALTIME_AUDIO=false
CHA_V2_FEATURE_REALTIME_CONTROL=false
CHA_V2_FEATURE_ACCOUNT_POOL_V2=false
CHA_V2_FEATURE_RECORDS_V2=false
